<?xml version="1.0" encoding="UTF-8"?>
<phpunit backupGlobals="false"
         backupStaticAttributes="false"
         bootstrap="./tests/bootstrap.php"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="true"
>
    <testsuites>
        <testsuite name="Listify Test Suite">
            <directory suffix=".php" phpVersion="8.0.0" phpVersionOperator=">=">./tests</directory>
        </testsuite>
    </testsuites>

    <php>
        <ini name="display_errors" value="true"/>
    </php>

    <coverage includeUncoveredFiles="false" processUncoveredFiles="true">
        <include>
            <file>src/Listify.php</file>
            <file>src/Config.php</file>
        </include>
        <report>
            <html outputDirectory="coverage" lowUpperBound="35" highLowerBound="70"/>
            <clover outputFile="clover.xml"/>
        </report>
    </coverage>
</phpunit>